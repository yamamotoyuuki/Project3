<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.pcmgmt.domain.mapper.loan.LoanMapper">

    <resultMap id="LoanResponseMap" type="com.company.pcmgmt.api.dto.response.loan.LoanResponse">
        <id     property="id"                 column="id"/>
        <result property="pcAssetId"          column="pc_asset_id"/>
        <result property="assetNumber"        column="asset_number"/>
        <result property="deviceName"         column="device_name"/>
        <result property="employeeId"         column="employee_id"/>
        <result property="employeeName"       column="employee_name"/>
        <result property="employeeCode"       column="employee_code"/>
        <result property="loanDate"           column="loan_date"/>
        <result property="expectedReturnDate" column="expected_return_date"/>
        <result property="actualReturnDate"   column="actual_return_date"/>
        <result property="purpose"            column="purpose"/>
        <result property="note"               column="note"/>
        <result property="createdBy"          column="created_by"/>
        <result property="createdByName"      column="created_by_name"/>
        <result property="createdAt"          column="created_at"/>
    </resultMap>

    <sql id="selectBase">
        SELECT
            l.id,
            l.pc_asset_id,
            a.asset_number,
            a.device_name,
            l.employee_id,
            e.full_name  AS employee_name,
            e.employee_code,
            l.loan_date,
            l.expected_return_date,
            l.actual_return_date,
            l.purpose,
            l.note,
            l.created_by,
            u.display_name AS created_by_name,
            l.created_at
        FROM pc_loans l
        JOIN pc_assets  a ON l.pc_asset_id  = a.id
        JOIN employees  e ON l.employee_id   = e.id
        LEFT JOIN users u ON l.created_by    = u.id
    </sql>

    <sql id="searchWhere">
        <where>
            <if test="req.keyword != null and req.keyword != ''">
                AND (
                    a.asset_number LIKE CONCAT('%', #{req.keyword}, '%')
                    OR a.device_name LIKE CONCAT('%', #{req.keyword}, '%')
                    OR e.full_name   LIKE CONCAT('%', #{req.keyword}, '%')
                )
            </if>
            <if test="req.returned != null">
                <choose>
                    <when test="req.returned == false">
                        AND l.actual_return_date IS NULL
                    </when>
                    <otherwise>
                        AND l.actual_return_date IS NOT NULL
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <select id="findAll" resultMap="LoanResponseMap">
        <include refid="selectBase"/>
        <include refid="searchWhere"/>
        ORDER BY l.created_at DESC
        LIMIT #{req.size} OFFSET #{req.offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM pc_loans l
        JOIN pc_assets a ON l.pc_asset_id = a.id
        JOIN employees e ON l.employee_id  = e.id
        <include refid="searchWhere"/>
    </select>

    <select id="findById" resultMap="LoanResponseMap">
        <include refid="selectBase"/>
        WHERE l.id = #{id}
    </select>

    <select id="findRawById" resultType="com.company.pcmgmt.domain.entity.PcLoan">
        SELECT * FROM pc_loans WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pc_loans (
            pc_asset_id, employee_id, loan_date,
            expected_return_date, purpose, note, created_by
        ) VALUES (
            #{pcAssetId}, #{employeeId}, #{loanDate},
            #{expectedReturnDate}, #{purpose}, #{note}, #{createdBy}
        )
    </insert>

    <update id="update">
        UPDATE pc_loans SET
            actual_return_date   = #{actualReturnDate},
            note                 = #{note}
        WHERE id = #{id}
    </update>

    <select id="findActiveLoanByAssetId" resultMap="LoanResponseMap">
        <include refid="selectBase"/>
        WHERE l.pc_asset_id = #{pcAssetId}
          AND l.actual_return_date IS NULL
        LIMIT 1
    </select>

    <select id="countActive" resultType="long">
        SELECT COUNT(*) FROM pc_loans WHERE actual_return_date IS NULL
    </select>

</mapper>
