<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.pcmgmt.domain.mapper.agent.AgentMapper">

    <!-- ============================================================ -->
    <!-- agents テーブル操作                                          -->
    <!-- ============================================================ -->

    <!--
        エージェント番号でエージェントを検索する
        - 存在すれば Agent エンティティを返す（UPDATE 判定に使用）
        - 存在しなければ null を返す（INSERT 判定に使用）
    -->
    <select id="findAgentByNumber" resultType="com.company.pcmgmt.domain.entity.Agent">
        SELECT agent_number, hostname, created_at, updated_at
        FROM agents
        WHERE agent_number = #{agentNumber}
    </select>

    <!--
        新規エージェントを登録する（初回起動時 / 初回レポート時）
        - agent_number はバックエンドが UUID から生成した値（"AGT-XXXXXXXX" 形式）
    -->
    <insert id="insertAgent">
        INSERT INTO agents (agent_number, hostname)
        VALUES (#{agentNumber}, #{hostname})
    </insert>

    <!--
        エージェントの最終更新日時を更新する（2回目以降のレポート受信時）
        - updated_at は ON UPDATE CURRENT_TIMESTAMP で自動更新されるが
          明示的に SET することで確実に更新する
    -->
    <update id="updateAgent">
        UPDATE agents
        SET updated_at = NOW()
        WHERE agent_number = #{agentNumber}
    </update>

    <!-- ============================================================ -->
    <!-- PC資産登録・検索                                              -->
    <!-- ============================================================ -->

    <!--
        エージェント報告時に対応する PC 資産が見つからない場合、自動登録する。
        - asset_number : 呼び出し側で "AUTO-XXXXXXXX" 形式に生成した一意な値
        - device_name  : エージェントのホスト名をそのまま使用
        - acquisition_type : リクエストの値、未指定時は "UNKNOWN"
        - status       : DB デフォルト値 "IN_STORAGE" を使用（明示的には渡さない）
        - agent_number : 同一トランザクション内で agents テーブルへの挿入が完了済みのため
                         FK 制約違反は発生しない
    -->
    <insert id="insertAsset">
        INSERT INTO pc_assets (
            asset_number,
            device_name,
            acquisition_type,
            hostname,
            agent_number,
            location,
            user_name,
            status
        ) VALUES (
            #{assetNumber},
            #{deviceName},
            #{acquisitionType},
            #{hostname},
            #{agentNumber},
            #{location},
            #{userName},
            'IN_STORAGE'
        )
    </insert>

    <!-- ============================================================ -->
    <!-- PC資産検索                                                    -->
    <!-- ============================================================ -->

    <!--
        エージェント番号でPC資産を検索する（主検索）
        V4 変更: ホスト名検索から agent_number 検索を主軸に変更
        - 2回目以降のレポートはエージェント番号で直接検索する
    -->
    <select id="findAssetByAgentNumber" resultType="com.company.pcmgmt.domain.entity.PcAsset">
        SELECT *
        FROM pc_assets
        WHERE agent_number = #{agentNumber}
        LIMIT 1
    </select>

    <!--
        ホスト名でPC資産を検索する（初回紐付け用フォールバック）
        - pc_assets.agent_number が未設定の場合（初回レポート）のみ使用する
        - 紐付け完了後は findAssetByAgentNumber を使用する
    -->
    <select id="findAssetByHostname" resultType="com.company.pcmgmt.domain.entity.PcAsset">
        SELECT *
        FROM pc_assets
        WHERE hostname = #{hostname}
        LIMIT 1
    </select>

    <!--
        PC資産にエージェント番号を紐付ける（初回レポート時の一回限り操作）
        - ホスト名で特定した後、agent_number カラムを設定する
        - 以後は agent_number での検索が有効になる
    -->
    <update id="linkAgentNumberToAsset">
        UPDATE pc_assets
        SET agent_number = #{agentNumber}
        WHERE hostname = #{hostname}
        LIMIT 1
    </update>

    <!-- ============================================================ -->
    <!-- ハードウェア情報 (pc_hardware_info テーブル)                 -->
    <!-- V4 変更: pc_asset_id → agent_number                         -->
    <!-- ============================================================ -->

    <!--
        エージェント番号でハードウェア情報を検索する（upsert の存在確認用）
        V4: pc_asset_id → agent_number に変更
    -->
    <select id="findHardwareByAgentNumber" resultType="com.company.pcmgmt.domain.entity.PcHardwareInfo">
        SELECT *
        FROM pc_hardware_info
        WHERE agent_number = #{agentNumber}
    </select>

    <!--
        ハードウェア情報を新規登録する（初回報告時）
        V4: pc_asset_id → agent_number に変更
    -->
    <insert id="insertHardware" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pc_hardware_info
            (agent_number, cpu_model, cpu_cores, memory_gb, disk_gb, disk_free_gb, collected_at)
        VALUES
            (#{agentNumber}, #{cpuModel}, #{cpuCores}, #{memoryGb}, #{diskGb}, #{diskFreeGb}, NOW())
    </insert>

    <!--
        ハードウェア情報を更新する（2回目以降の報告時）
        V4: WHERE 条件を pc_asset_id → agent_number に変更
    -->
    <update id="updateHardware">
        UPDATE pc_hardware_info SET
            cpu_model    = #{cpuModel},
            cpu_cores    = #{cpuCores},
            memory_gb    = #{memoryGb},
            disk_gb      = #{diskGb},
            disk_free_gb = #{diskFreeGb},
            collected_at = NOW(),
            updated_at   = NOW()
        WHERE agent_number = #{agentNumber}
    </update>

    <!-- ============================================================ -->
    <!-- ソフトウェア情報 (pc_software_info テーブル)                 -->
    <!-- V4 変更: pc_asset_id → agent_number                         -->
    <!-- ============================================================ -->

    <!--
        ソフトウェア情報を全件削除する（再登録前の全削除）
        V4: WHERE 条件を pc_asset_id → agent_number に変更
    -->
    <delete id="deleteSoftwareByAgentNumber">
        DELETE FROM pc_software_info
        WHERE agent_number = #{agentNumber}
    </delete>

    <!--
        ソフトウェア情報を1件登録する
        V4: pc_asset_id → agent_number に変更
    -->
    <insert id="insertSoftware">
        INSERT INTO pc_software_info
            (agent_number, software_name, version, publisher, install_date, collected_at)
        VALUES (
            #{agentNumber},
            #{softwareName},
            #{version},
            #{publisher},
            <choose>
                <when test="installDate != null and installDate != ''">
                    STR_TO_DATE(#{installDate}, '%Y-%m-%d')
                </when>
                <otherwise>NULL</otherwise>
            </choose>,
            NOW()
        )
    </insert>

    <!-- ============================================================ -->
    <!-- ネットワーク情報 (pc_network_info テーブル)                  -->
    <!-- V4 変更: pc_asset_id → agent_number                         -->
    <!-- ============================================================ -->

    <!--
        ネットワーク情報を全件削除する（再登録前の全削除）
        V4: WHERE 条件を pc_asset_id → agent_number に変更
    -->
    <delete id="deleteNetworkByAgentNumber">
        DELETE FROM pc_network_info
        WHERE agent_number = #{agentNumber}
    </delete>

    <!--
        ネットワーク情報（NIC 1枚分）を登録する
        V4: pc_asset_id → agent_number に変更
    -->
    <insert id="insertNetwork">
        INSERT INTO pc_network_info
            (agent_number, nic_name, ip_address, mac_address, collected_at)
        VALUES
            (#{agentNumber}, #{nicName}, #{ipAddress}, #{macAddress}, NOW())
    </insert>

    <!-- ============================================================ -->
    <!-- 使用者名 → 社員ID 変換                                       -->
    <!-- ============================================================ -->

    <!-- 使用者名（full_name）で社員IDを検索する -->
    <select id="findEmployeeIdByName" resultType="java.lang.Long">
        SELECT id
        FROM employees
        WHERE full_name = #{fullName}
        LIMIT 1
    </select>

    <!-- ============================================================ -->
    <!-- APIキー管理 (agents テーブル)                                -->
    <!-- ============================================================ -->

    <!--
        エージェントの api_key_hash を更新する（初回登録時に呼び出す）
        - 平文の API キーはバックエンドで生成し bcrypt ハッシュ化後にここで保存する
        - 平文は絶対に DB に保存しない（エージェントへのレスポンスで一度だけ返却）
    -->
    <update id="updateApiKeyHash">
        UPDATE agents
        SET api_key_hash = #{apiKeyHash}
        WHERE agent_number = #{agentNumber}
    </update>

    <!--
        エージェント番号で api_key_hash を取得する（リクエスト検証に使用）
        - report / asset-info エンドポイントで Authorization ヘッダーの API キーを検証する際に使用
    -->
    <select id="findApiKeyHashByAgentNumber" resultType="java.lang.String">
        SELECT api_key_hash
        FROM agents
        WHERE agent_number = #{agentNumber}
        LIMIT 1
    </select>

    <!-- ============================================================ -->
    <!-- PC資産更新 (pc_assets テーブル)                              -->
    <!-- V4 変更: WHERE 条件を id → agent_number に変更               -->
    <!-- ============================================================ -->

    <!--
        エージェントの最終接続日時・設置場所・使用者を更新する
        V4 変更:
          - WHERE 条件を id から agent_number に変更
          - agent_number の更新は linkAgentNumberToAsset で行うため本SQLからは削除
    -->
    <update id="updateAgentLastSeen">
        UPDATE pc_assets SET
            agent_last_seen = NOW()
            <!-- 設置場所が送信された場合のみ更新する -->
            <if test="location != null and location != ''">
                , location = #{location}
            </if>
            <!-- 使用者名が送信された場合のみ更新する -->
            <if test="userName != null and userName != ''">
                , user_name = #{userName}
            </if>
            <!-- 社員照合が成功した場合のみ担当社員を更新する -->
            <if test="assignedEmployeeId != null">
                , assigned_employee_id = #{assignedEmployeeId}
            </if>
        WHERE agent_number = #{agentNumber}
    </update>

    <!--
        PC資産の取得区分を更新する
        V4 変更: WHERE 条件を id から agent_number に変更
        - エージェントが「購入」または「レンタル」を選択して送信した場合に呼び出す
        - バックエンドに既に値が設定済みの場合はエージェント側がdisabledになるため呼び出されない
    -->
    <update id="updateAcquisitionType">
        UPDATE pc_assets
        SET acquisition_type = #{acquisitionType}
        WHERE agent_number = #{agentNumber}
    </update>

</mapper>
