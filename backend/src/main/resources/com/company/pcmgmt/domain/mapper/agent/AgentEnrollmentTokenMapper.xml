<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.pcmgmt.domain.mapper.agent.AgentEnrollmentTokenMapper">

    <!-- ============================================================ -->
    <!-- ResultMap: agent_enrollment_tokens テーブルのカラムマッピング  -->
    <!-- ============================================================ -->
    <resultMap id="tokenResultMap" type="com.company.pcmgmt.domain.entity.AgentEnrollmentToken">
        <id     property="id"                 column="id"/>
        <result property="token"              column="token"/>
        <result property="expiresAt"          column="expires_at"/>
        <result property="usedAt"             column="used_at"/>
        <result property="usedByAgentNumber"  column="used_by_agent_number"/>
        <result property="note"               column="note"/>
        <result property="createdByUserId"    column="created_by_user_id"/>
        <result property="createdAt"          column="created_at"/>
    </resultMap>

    <!-- ============================================================ -->
    <!-- INSERT: 登録トークン新規発行                                    -->
    <!-- ============================================================ -->
    <!--
        新規登録トークンを INSERT する。
        - expires_at は呼び出し側（サービス層）で NOW() + 24時間 に設定する
        - used_at / used_by_agent_number は NULL（未使用）
        - created_at は DB デフォルト値（CURRENT_TIMESTAMP）を使用
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_enrollment_tokens (
            token,
            expires_at,
            note,
            created_by_user_id
        ) VALUES (
            #{token},
            #{expiresAt},
            #{note},
            #{createdByUserId}
        )
    </insert>

    <!-- ============================================================ -->
    <!-- SELECT: トークン文字列で検索                                   -->
    <!-- ============================================================ -->
    <!--
        トークン文字列でレコードを取得する。
        エージェント登録時の検証（有効期限・使用済み確認）に使用する。
    -->
    <select id="findByToken" resultMap="tokenResultMap">
        SELECT
            id,
            token,
            expires_at,
            used_at,
            used_by_agent_number,
            note,
            created_by_user_id,
            created_at
        FROM agent_enrollment_tokens
        WHERE token = #{token}
        LIMIT 1
    </select>

    <!-- ============================================================ -->
    <!-- UPDATE: トークンを使用済みにマーク                             -->
    <!-- ============================================================ -->
    <!--
        エージェント登録成功後にトークンを使用済みにする。
        - used_at: NOW()（使用日時を記録）
        - used_by_agent_number: 登録されたエージェント番号
        未使用（used_at IS NULL）のもののみ更新することで二重使用を防ぐ。
    -->
    <update id="markAsUsed">
        UPDATE agent_enrollment_tokens
        SET
            used_at              = NOW(),
            used_by_agent_number = #{usedByAgentNumber}
        WHERE token    = #{token}
          AND used_at IS NULL
    </update>

    <!-- ============================================================ -->
    <!-- SELECT: 全トークン一覧取得（管理画面用）                       -->
    <!-- ============================================================ -->
    <!--
        発行日時の降順で全トークンを返す。
        管理画面でのトークン一覧表示（有効・使用済み・期限切れを含む全件）に使用する。
    -->
    <select id="findAll" resultMap="tokenResultMap">
        SELECT
            id,
            token,
            expires_at,
            used_at,
            used_by_agent_number,
            note,
            created_by_user_id,
            created_at
        FROM agent_enrollment_tokens
        ORDER BY created_at DESC
    </select>

    <!-- ============================================================ -->
    <!-- DELETE: IDでトークンを削除（管理者による強制無効化）            -->
    <!-- ============================================================ -->
    <!--
        管理者が未使用トークンをキャンセルする際に使用する。
        使用済みトークンの削除もここで行う（履歴削除）。
    -->
    <delete id="deleteById">
        DELETE FROM agent_enrollment_tokens
        WHERE id = #{id}
    </delete>

</mapper>
