<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.pcmgmt.domain.mapper.PcAssetMapper">

    <!-- 結果マップ -->
    <resultMap id="AssetResponseMap" type="com.company.pcmgmt.api.dto.response.AssetResponse">
        <id     property="id"                   column="id"/>
        <result property="assetNumber"          column="asset_number"/>
        <result property="deviceName"           column="device_name"/>
        <result property="acquisitionType"      column="acquisition_type"/>
        <result property="maker"                column="maker"/>
        <result property="modelNumber"          column="model_number"/>
        <result property="serialNumber"         column="serial_number"/>
        <result property="location"             column="location"/>
        <result property="status"               column="status"/>
        <result property="assignedEmployeeId"   column="assigned_employee_id"/>
        <result property="assignedEmployeeName" column="assigned_employee_name"/>
        <!-- エージェントが報告した使用者名（自由テキスト）を user_name カラムからマッピング -->
        <result property="userName"             column="user_name"/>
        <!-- エージェント番号（agents テーブルとの紐付けキー） -->
        <result property="agentNumber"          column="agent_number"/>
        <result property="hostname"             column="hostname"/>
        <result property="agentLastSeen"        column="agent_last_seen"/>
        <result property="note"                 column="note"/>
        <result property="createdAt"            column="created_at"/>
        <result property="updatedAt"            column="updated_at"/>
    </resultMap>

    <!-- 検索条件フラグメント -->
    <sql id="searchWhere">
        <where>
            <if test="req.keyword != null and req.keyword != ''">
                AND (
                    a.asset_number  LIKE CONCAT('%', #{req.keyword}, '%')
                    OR a.device_name    LIKE CONCAT('%', #{req.keyword}, '%')
                    OR a.serial_number  LIKE CONCAT('%', #{req.keyword}, '%')
                    OR a.hostname       LIKE CONCAT('%', #{req.keyword}, '%')
                )
            </if>
            <if test="req.status != null and req.status != ''">
                AND a.status = #{req.status}
            </if>
            <if test="req.acquisitionType != null and req.acquisitionType != ''">
                AND a.acquisition_type = #{req.acquisitionType}
            </if>
            <if test="req.location != null and req.location != ''">
                AND a.location LIKE CONCAT('%', #{req.location}, '%')
            </if>
        </where>
    </sql>

    <!-- 一覧取得 -->
    <select id="findAll" resultMap="AssetResponseMap">
        SELECT
            a.id,
            a.asset_number,
            a.device_name,
            a.acquisition_type,
            a.maker,
            a.model_number,
            a.serial_number,
            a.location,
            a.status,
            a.assigned_employee_id,
            e.full_name AS assigned_employee_name,
            a.user_name,
            a.agent_number,
            a.hostname,
            a.agent_last_seen,
            a.note,
            a.created_at,
            a.updated_at
        FROM pc_assets a
        LEFT JOIN employees e ON a.assigned_employee_id = e.id
        <include refid="searchWhere"/>
        ORDER BY a.created_at DESC
        LIMIT #{req.size} OFFSET #{req.offset}
    </select>

    <!-- 件数取得 -->
    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM pc_assets a
        <include refid="searchWhere"/>
    </select>

    <!-- ID で1件取得 -->
    <select id="findById" resultMap="AssetResponseMap">
        SELECT
            a.id,
            a.asset_number,
            a.device_name,
            a.acquisition_type,
            a.maker,
            a.model_number,
            a.serial_number,
            a.location,
            a.status,
            a.assigned_employee_id,
            e.full_name AS assigned_employee_name,
            a.user_name,
            a.agent_number,
            a.hostname,
            a.agent_last_seen,
            a.note,
            a.created_at,
            a.updated_at
        FROM pc_assets a
        LEFT JOIN employees e ON a.assigned_employee_id = e.id
        WHERE a.id = #{id}
    </select>

    <!-- エンティティとして取得 -->
    <select id="findRawById" resultType="com.company.pcmgmt.domain.entity.PcAsset">
        SELECT * FROM pc_assets WHERE id = #{id}
    </select>

    <!-- 登録 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pc_assets (
            asset_number, device_name, acquisition_type,
            maker, model_number, serial_number,
            location, status, assigned_employee_id,
            hostname, note
        ) VALUES (
            #{assetNumber}, #{deviceName}, #{acquisitionType},
            #{maker}, #{modelNumber}, #{serialNumber},
            #{location}, #{status}, #{assignedEmployeeId},
            #{hostname}, #{note}
        )
    </insert>

    <!-- 更新 -->
    <!-- location（設置場所）はエージェントが AgentMapper.updateAgentLastSeen で更新するため、
         手動編集の UPDATE では対象外とする -->
    <update id="update">
        UPDATE pc_assets SET
            device_name          = #{deviceName},
            acquisition_type     = #{acquisitionType},
            maker                = #{maker},
            model_number         = #{modelNumber},
            serial_number        = #{serialNumber},
            status               = #{status},
            assigned_employee_id = #{assignedEmployeeId},
            hostname             = #{hostname},
            note                 = #{note},
            updated_at           = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 削除 -->
    <delete id="deleteById">
        DELETE FROM pc_assets WHERE id = #{id}
    </delete>

    <!-- 資産番号重複チェック -->
    <select id="existsByAssetNumber" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM pc_assets
        WHERE asset_number = #{assetNumber}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- ステータス別件数 -->
    <select id="countByStatus" resultType="long">
        SELECT COUNT(*) FROM pc_assets WHERE status = #{status}
    </select>

    <!-- 総件数 -->
    <select id="countTotal" resultType="long">
        SELECT COUNT(*) FROM pc_assets
    </select>

</mapper>
