# =============================
# PC管理システム 環境変数設定例
# .env にコピーして値を設定してください
# =============================

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=pcmgmt
MYSQL_USER=pcmgmt
MYSQL_PASSWORD=pcmgmt_password

# JWT (本番環境では必ず変更すること)
JWT_SECRET=your-super-secret-key-change-in-production-min-256bits
JWT_EXPIRATION=86400000
