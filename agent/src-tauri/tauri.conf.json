{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC管理エージェント",
  "version": "1.0.0",
  "identifier": "com.company.pcmgmt-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PC管理エージェント",
        "width": 420,
        "height": 700,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "application.yml"
    ]
  },
  "plugins": {}
}
